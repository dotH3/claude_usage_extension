{
  "manifest_version": 3,
  "name": "Usage Monitor",
  "version": "2.1.0",
  "description": "Monitor Claude and OpenCode Go usage, limits, and reset times.",
  "permissions": [
    "storage",
    "cookies",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://opencode.ai/*",
    "http://localhost:19876/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Usage Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
